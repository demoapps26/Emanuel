{
  "name": "patricia-pilar-mundo-3d",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "standalone": "npm run build && node scripts/standalone.mjs",
    "package:download": "npm run standalone && python3 scripts/package-download.py",
    "map:dev": "vite --host 0.0.0.0 --port 5174",
    "map:build": "vite build --config vite.map.config.mjs && node scripts/build-map.mjs",
    "map:package": "npm run map:build && python3 scripts/package-map.py",
    "test:map:browser": "node tests/map-browser.mjs",
    "test:explore:browser": "node tests/explore-browser.mjs",
    "sacos:dev": "vite --host 0.0.0.0 --port 5175",
    "sacos:build": "vite build --config vite.sacos.config.mjs && node scripts/build-sacos.mjs",
    "sacos:package": "npm run sacos:build && python3 scripts/package-sacos.py",
    "test:sacos:browser": "node tests/sacos-browser.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
